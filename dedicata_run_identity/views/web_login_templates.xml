<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="web_login_hide_password_form"
        inherit_id="web.login"
        name="Dedicata Run Hide Password Login"
    >
        <!--
            Hide the entire password login form when SSO enforcement is active.
            Targets the form by its action URL (stable across Odoo versions) and
            uses inline style so no CSS class name assumptions are needed.
            The `dedicata_local` param is an escape hatch for ops access.
        -->
        <xpath expr="//form[@action='/web/login']" position="attributes">
            <attribute name="t-att-style">
                "display:none" if (
                    request.env['dedicata.run.identity'].sudo().should_hide_password_form()
                    and not request.params.get('dedicata_local')
                ) else None
            </attribute>
        </xpath>
    </template>
</odoo>
