<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="web_login_hide_password_form"
        inherit_id="web.login"
        name="Dedicata Run Hide Password Login"
    >
        <xpath
            expr="//form[contains(@t-attf-class, 'oe_login_form')]"
            position="attributes"
        >
            <attribute
                name="t-attf-class"
            >oe_login_form #{'' if (login or request.params.get('dedicata_local') or request.env['dedicata.run.identity'].sudo().should_hide_password_form()) else 'd-none'}</attribute>
        </xpath>
        <xpath expr="//*[hasclass('field-login')]" position="attributes">
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>
        <xpath expr="//*[hasclass('o_caps_lock_warning')]" position="attributes">
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>
        <xpath
            expr="//button[@type='submit' and hasclass('btn-primary')]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>
    </template>
</odoo>
