<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="web_login_hide_password_form"
        inherit_id="web.login"
        name="Dedicata Run Hide Password Login"
    >
        <!--
        Odoo 18 hides the form by default via t-attf-class="oe_login_form #{...
        d-none}". Override it to keep the form (and the SSO buttons inside it)
        visible when SSO is active.
        -->
        <xpath expr="//form[@method='post']" position="attributes">
            <attribute
                name="t-attf-class"
            >oe_login_form #{'' if (login or request.params.get('dedicata_local') or request.env['dedicata.run.identity'].sudo().should_hide_password_form()) else 'd-none'}</attribute>
        </xpath>

        <!-- Hide email field when SSO is active (keep SSO buttons visible) -->
        <xpath
            expr="//form[@method='post']//*[hasclass('field-login')]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>

        <!-- Hide password wrapper when SSO is active.
             v18 has no o_caps_lock_warning class; target the parent of the input. -->
        <xpath
            expr="//form[@method='post']//input[@id='password']/.."
            position="attributes"
        >
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>

        <!-- Hide Log in submit button when SSO is active -->
        <xpath
            expr="//form[@method='post']//button[@type='submit']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not request.env['dedicata.run.identity'].sudo().should_hide_password_form() or request.params.get('dedicata_local')</attribute>
        </xpath>

        <!-- Add "Login with email and password" fallback link for portal users -->
        <xpath
            expr="//form[@method='post']//*[hasclass('oe_login_buttons')]"
            position="inside"
        >
            <t
                t-if="request.env['dedicata.run.identity'].sudo().should_hide_password_form() and not request.params.get('dedicata_local')"
            >
                <div class="text-center mt-3">
                    <a href="?dedicata_local=1" class="btn btn-link btn-sm text-muted">
                        <small>Login with email and password</small>
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
